# Local-only test infrastructure (per design spec, tests stay local)
tests/
.pii-blocklist

# Build artifacts
dist/

# Autoresearch loop artifacts (probe reports + findings, local-only)
autoresearch/

# Local-only authoring + planning artifacts (never push to public repo).
# Everything under docs/ is local-only EXCEPT the public install + smoke-test guide.
CLAUDE.md
docs/*
!docs/install-and-smoke-test.md

# Similarweb product UI screenshots (brand/IP, never push)
sw-*.png

# User-side capabilities cache (lives in $HOME, never in repo)
.similarweb-plugin/

# Editor / OS
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Scratch and editor artifacts
.playwright-mcp/
*.tmp
*.bak
*.swp
.env
.env.*
.aider*

# Stray screenshots and captures dropped in the repo root. Deliberately
# root-only (a leading slash) so assets/ and docs/ images still track normally.
# Four analyst screenshots were swept into a release commit by `git add -A`
# on 2026-08-09; this keeps a loose file in the working directory from
# becoming a public artifact again.
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.pdf
